# ---------------------------------------------------------------------------
# Selva Muthukumarasamy Temple Donation Management - environment variables
# Copy this file to .env for local development. NEVER commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon pooled URL in production).
# Local example:  postgresql://USER:PASSWORD@localhost:5432/smt_temple
# Neon example:   postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secret used to sign session cookies. Minimum 32 random characters.
# Generate with:  openssl rand -base64 48
AUTH_SECRET=

# Public base URL of the app (used for receipt share links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seed script only (npm run db:seed). Not needed at runtime.
# Provide these on the command line or in a local .env that is NOT committed.
# The password is hashed with bcrypt before storage and is never printed.
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME="Temple Administrator"
SEED_ADMIN_EMAIL=admin@selvamuthukumarasamy.in
SEED_ADMIN_PASSWORD=
